{
  "openapi": "3.0.4",
  "info": {
    "title": "ScmCore.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/erp/inventory": {
      "get": {
        "tags": [
          "ScmEnterprise"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/erp/sync-competitor-prices": {
      "post": {
        "tags": [
          "ScmEnterprise"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScrapeSyncRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ScrapeSyncRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ScrapeSyncRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/erp/simulate-what-if": {
      "post": {
        "tags": [
          "ScmEnterprise"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatIfRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatIfRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/WhatIfRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/erp/trigger-ai-audit": {
      "post": {
        "tags": [
          "ScmEnterprise"
        ],
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "gemini-3.5-flash-lite"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/erp/recommendations": {
      "get": {
        "tags": [
          "ScmEnterprise"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "PENDING"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/erp/recommendations/{recommendationId}/approve": {
      "post": {
        "tags": [
          "ScmEnterprise"
        ],
        "parameters": [
          {
            "name": "recommendationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/erp/recommendations/{recommendationId}/reject": {
      "post": {
        "tags": [
          "ScmEnterprise"
        ],
        "parameters": [
          {
            "name": "recommendationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RejectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/erp/purchase-orders": {
      "get": {
        "tags": [
          "ScmEnterprise"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/erp/purchase-orders/{poId}/receive-grn": {
      "post": {
        "tags": [
          "ScmEnterprise"
        ],
        "parameters": [
          {
            "name": "poId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReceiveGrnRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ReceiveGrnRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReceiveGrnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/erp/ledgers": {
      "get": {
        "tags": [
          "ScmEnterprise"
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApproveRequest": {
        "type": "object",
        "properties": {
          "warehouseId": {
            "type": "string",
            "nullable": true
          },
          "managerUsername": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReceiveGrnRequest": {
        "type": "object",
        "properties": {
          "acceptedQty": {
            "type": "integer",
            "format": "int32"
          },
          "actualInvoiceUnitCost": {
            "type": "integer",
            "format": "int64"
          },
          "supplierInvoiceNo": {
            "type": "string",
            "nullable": true
          },
          "warehouseKeeper": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RejectRequest": {
        "type": "object",
        "properties": {
          "managerUsername": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ScrapeSyncRequest": {
        "type": "object",
        "properties": {
          "providerMode": {
            "type": "string",
            "nullable": true
          },
          "forceAi": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "WhatIfRequest": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "nullable": true
          },
          "customOnHandStock": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "customListedPrice": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "customCompetitorPrice": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "serviceLevelZ": {
            "type": "number",
            "format": "double"
          },
          "elasticity": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "ScmEnterprise"
    }
  ]
}